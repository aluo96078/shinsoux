@@ -75,7 +78,8 @@ if(SSPLIT_USE_INTERNAL_PCRE2)
     URL ${PCRE2_URL}
     DOWNLOAD_DIR ${PCRE2_SRC_DIR}
     SOURCE_DIR ${PCRE2_SRC_DIR}

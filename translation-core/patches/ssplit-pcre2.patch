diff --git a/cmake/FindPCRE2.cmake b/cmake/FindPCRE2.cmake
index 8ea55cb..4d94fd6 100644
--- a/cmake/FindPCRE2.cmake
+++ b/cmake/FindPCRE2.cmake
@@ -33,7 +33,7 @@ if(SSPLIT_USE_INTERNAL_PCRE2)
     # jit compilation isn't supported by wasm
     set(PCRE2_JIT_OPTION  "-DPCRE2_SUPPORT_JIT=OFF")
   else()
-    set(PCRE2_JIT_OPTION  "-DPCRE2_SUPPORT_JIT=ON")
+    set(PCRE2_JIT_OPTION  "-DPCRE2_SUPPORT_JIT=OFF")
   endif()
 
   # CMAKE_CROSSCOMPILING_EMULATOR might contain semicolon (;) separated arguments. Preventing list
@@ -46,6 +46,9 @@ if(SSPLIT_USE_INTERNAL_PCRE2)
     -DBUILD_SHARED_LIBS=OFF
     -DCMAKE_INSTALL_PREFIX=${CMAKE_BINARY_DIR}
     -DCMAKE_BUILD_TYPE=Release
+    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
+    -DPCRE2_BUILD_PCRE2GREP=OFF
+    -DPCRE2_BUILD_TESTS=OFF
     -DCMAKE_INSTALL_LIBDIR=${CMAKE_INSTALL_LIBDIR}
     ${PCRE2_JIT_OPTION}

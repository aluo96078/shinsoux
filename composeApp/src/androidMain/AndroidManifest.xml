<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 14+: downloads run as a user-initiated data transfer job. -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/shinsou_icon"
        android:label="Shinsou X"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:zygotePreloadName="dev.shinsou.kmp.plugin.sandbox.SandboxZygotePreload">
        <!--
          ADR-0002 §4.3: third-party plugin sandbox. One isolated process per package, bound with
          Context.bindIsolatedService and a unique instance name. Isolated uid: no app permissions
          (no INTERNET), no access to the app's files; seccomp forbids exec and fork on top.
        -->
        <service
            android:name="dev.shinsou.kmp.plugin.sandbox.SandboxProcessService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":sandbox"
            android:useAppZygote="true" />

        <!-- Keeps downloads running in the background on Android 10–13 (and as a fallback). -->
        <service
            android:name="dev.shinsou.kmp.AndroidDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Android 14+: user-initiated data transfer job for background downloads. -->
        <service
            android:name="dev.shinsou.kmp.AndroidDownloadJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <activity
            android:name="dev.shinsou.kmp.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|keyboard|keyboardHidden|navigation"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="shinsou" />
            </intent-filter>
        </activity>
    </application>
</manifest>

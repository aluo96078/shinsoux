<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Google Code Scanner owns camera access, so Shinsou X does not request CAMERA itself. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/shinsou_icon"
        android:label="Shinsou X"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:zygotePreloadName="dev.shinsou.kmp.plugin.sandbox.SandboxZygotePreload">
        <!-- Ask Play services to download the permissionless QR scanner module ahead of use. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!--
          ADR-0002 §4.3: third-party plugin sandbox. One isolated process per package, bound with
          Context.bindIsolatedService and a unique instance name. Isolated uid: no app permissions
          (no INTERNET), no access to the app's files; seccomp forbids exec and fork on top.
        -->
        <service
            android:name="dev.shinsou.kmp.plugin.sandbox.SandboxProcessService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":sandbox"
            android:useAppZygote="true" />

        <activity
            android:name="dev.shinsou.kmp.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|keyboard|keyboardHidden|navigation"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="shinsou" />
            </intent-filter>
        </activity>
    </application>
</manifest>

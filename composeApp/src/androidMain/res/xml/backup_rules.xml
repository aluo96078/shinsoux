<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Keystore keys cannot be restored with these values, and local content is device-owned. -->
    <exclude domain="sharedpref" path="shinsou-plugin-state.xml" />
    <exclude domain="file" path="shinsou-content/" />
    <!-- Local replica/session/device identity cannot be restored without this install's Keystore key. -->
    <exclude domain="database" path="shinsou-sync-v2.db" />
    <exclude domain="database" path="shinsou-sync-v2.db-wal" />
    <exclude domain="database" path="shinsou-sync-v2.db-shm" />
    <exclude domain="database" path="shinsou-sync-v2.db.before-upgrade" />
    <exclude domain="database" path="shinsou-sync-v2.db.before-upgrade-wal" />
    <exclude domain="database" path="shinsou-sync-v2.db.before-upgrade.partial" />
    <exclude domain="database" path="shinsou-sync-v2.db.before-upgrade-wal.partial" />
    <exclude domain="database" path="shinsou-sync-v2.db.before-upgrade.of" />
    <exclude domain="file" path="shinsou-state.json.before-hot-state" />
    <exclude domain="file" path="shinsou-state.json.before-hot-state.partial" />
    <exclude domain="file" path="shinsou-state.json.hot-state-kept" />
    <exclude domain="file" path="shinsou-state.json.hot-state-kept.partial" />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      ADR-0002 §4.3: third-party plugin sandbox. One isolated process per package, bound with
      Context.bindIsolatedService and a unique instance name. Isolated uid: no app permissions
      (no INTERNET), no access to the app's files; seccomp forbids exec and fork on top.
      R5-1: merged into the app's manifest; the isolated process loads libshinsou_sandbox.so,
      which this module's external native build packages.
    -->
    <application android:zygotePreloadName="dev.shinsou.kmp.plugin.sandbox.SandboxZygotePreload">
        <service
            android:name="dev.shinsou.kmp.plugin.sandbox.SandboxProcessService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":sandbox"
            android:useAppZygote="true" />
        <!--
          R5-3: the release workflow's sandbox round trip on the shrunk APK (SandboxSelfCheckReceiver).
          Only holders of DUMP (the shell, the system) can send it; no app can.
        -->
        <receiver
            android:name="dev.shinsou.kmp.plugin.sandbox.SandboxSelfCheckReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>

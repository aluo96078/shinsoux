<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      The sandbox's device tests run in this module's own test APK. It holds what the app holds
      (INTERNET, like composeApp's manifest), so the isolation tests show that an isolated child
      does not inherit its host's permissions, rather than passing because the host had none.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>

* text=auto
*.bat text eol=crlf
# Pinned ShuYue repository fixtures are verified by exact byte size and SHA-256.
# Keep their LF bytes unchanged on Windows; CRLF conversion invalidates provenance.
composeApp/src/desktopTest/resources/shuyue-plugin/** -text
# sandbox-core's patches apply to LF upstream sources; its scripts run under bash on Windows too.
sandbox-core/patches/*.patch text eol=lf
sandbox-core/scripts/*.sh text eol=lf

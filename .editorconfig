root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = off
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

# Bytes that are compared or applied as they are: an editor must not tidy them.
[{*.patch,*.dat,**/fixtures/**}]
trim_trailing_whitespace = false
insert_final_newline = unset
end_of_line = unset
charset = unset
